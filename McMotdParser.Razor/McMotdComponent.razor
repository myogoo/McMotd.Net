@using McMotdParser.Enum
@implements IAsyncDisposable

@((MarkupString)html)

@code {
    [Parameter]
    public string RawMotdString { get; set; } = string.Empty;

    [Parameter]
    public MotdParserOptions? ParserOptions { get; set; }

    private MotdParser parser = new MotdParser();
    private List<MotdContent> contents = new List<MotdContent>();
    private string html = string.Empty;
    private CancellationTokenSource? animationCancellation;
    private Task animation = Task.CompletedTask;
    private int renderVersion;
    private bool disposed;

    protected override async Task OnParametersSetAsync()
    {
        int version = ++renderVersion;
        await StopAnimation();
        if (disposed || version != renderVersion) return;
        parser = new MotdParser(ParserOptions ?? new MotdParserOptions());
        contents = parser.deserialize(RawMotdString ?? string.Empty);
        html = parser.RenderHtml(contents);
        if (contents.Any(content => content.TextFormatting.Contains(TextFormatEnum.Obfuscated)))
        {
            animationCancellation = new CancellationTokenSource();
            animation = Animate(animationCancellation.Token);
        }
    }

    private async Task Animate(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(() =>
                {
                    if (cancellationToken.IsCancellationRequested) return;
                    html = parser.RenderHtml(contents);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private async Task StopAnimation()
    {
        var cancellation = animationCancellation;
        var previousAnimation = animation;
        animationCancellation = null;
        animation = Task.CompletedTask;
        if (cancellation == null) return;
        cancellation.Cancel();
        await previousAnimation;
        cancellation.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        renderVersion++;
        await StopAnimation();
    }
}
