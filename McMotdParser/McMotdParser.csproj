<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>McMotd.Net</PackageId>
    <Authors>NJoyShadow</Authors>
    <Version>0.1.0</Version>
    <Copyright>Copyright (c) NJoyShadow 2023</Copyright>
    <PackageProjectUrl>https://github.com/myogoo/McMotd.Net</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>minecraft,motd,minecraft-motd</PackageTags>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>
      McMotd can parse Raw minecraft motd to Html as string
    </Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/myogoo/McMotd.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="README.md"/>
    <None Include="../LICENSE.txt" Pack="true" PackagePath="\"/>
  </ItemGroup>
</Project>
